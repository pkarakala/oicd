  url          = {https://www.ieee802.org/3/dj/public/26_09/dawe_3dj_01_2609.pdf},
  note         = {Read in full 2026-10-18 (PDF, 14 slides; footer dated Aug 2026). Class: proposed standard (open comment R2-199 against the D3.x draft). States the current draft values: ER min 3.5 dB, RX sensitivity -3.4 and -4.3 + TECQ, power budget 6.7 dB, penalties 3.7 dB, MPI allocation 0.1 dB, Table 180-12 unchanged. Proposes ER 3 dB, sensitivity -4.5 + TECQ, budget 6.9 dB, penalties 3.9 dB (MPI up to 0.3 dB). The source does not say whether the change was adopted.}
}

@techreport{simms2026_3dj_tt,
