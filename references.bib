@techreport{bhatt2016_mpi,
  title        = {Estimating {MPI} Penalty},
  author       = {Bhatt, Vipul and Smith, Benjamin},
  institution  = {IEEE 802.3bs SMF Ad Hoc},
  year         = {2016},
  month        = jan,
  url          = {https://www.ieee802.org/3/bs/public/adhoc/smf/16_01_07/bhatt_01_0116_smf.pdf},
  note         = {Read in full 2026-10-18 (PDF, 25 slides). Class: proposed standard (task-force contribution). Deterministic MPI upper bound: penalty = 10 log10(1/(1 - x)), x = (m - 1) 4 S E/(E - 1), S = sqrt(Rt Rr) + n sqrt(Rt Rc) + n sqrt(Rr Rc) + n(n - 1)/2 Rc. Table 1, DR4 D1.0 (Tx 20, Rx 26, connector 35 dB reflectance; PAM4; ER 6 dB): 0.81, 1.44 and 2.31 dB for 2, 4 and 6 connectors. Discount factors D = 0.5 to 0.7 discussed as less pessimistic.}
}

@techreport{anslow2017_drrefl,
  title        = {{100GBASE-DR} optical reflection limits},
  author       = {Anslow, Pete},
  institution  = {IEEE P802.3cd Task Force},
  year         = {2017},
  month        = may,
  url          = {https://www.ieee802.org/3/cd/public/May17/anslow_3cd_01_0517.pdf},
  note         = {Read in full 2026-10-18 (PDF, 10 slides). Class: proposed standard (task-force contribution). States that during P802.3bs the MPI penalty allocation was agreed to equal the 1E-6 cumulative probability point of the Monte Carlo spreadsheet king_02a_0116_smf.}
}

@techreport{bhatt2001_bidixtalk,
  title        = {Cross-talk in bi-directional, single wavelength, single fiber {Gigabit Ethernet} links},
  author       = {Bhatt, Vipul},
  institution  = {IEEE 802.3 EFM Study Group},
  year         = {2001},
  month        = jun,
  url          = {https://www.ieee802.org/3/efm/public/jul01/presentations/bhatt_1_0701.pdf},
  note         = {Read in full 2026-10-18 (PDF, 10 pages, dated June 28, 2001). Class: proposed standard (study-group contribution). For single-wavelength BiDi with non-WDM couplers, NRZ and an adjusted receiver threshold: crosstalk penalty approx. 10 log(channel_loss/(channel_loss - return_loss)), both as fractions; example IL 7 dB, RL 12 dB gives 1.65 dB; thumb rule: return loss at least 5 dB greater than channel insertion loss.}
}

