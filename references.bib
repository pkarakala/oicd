@techreport{welch2023_3dj_baseline,
  title        = {Baseline proposals for 200G/L PMD 500 m and 2 km objectives},
  author       = {Welch, Brian and Ingham, Jonathan and Bernier, Eric and Dawe, Piers and Johnson, John},
  institution  = {IEEE P802.3dj Task Force},
  number       = {welch\_3dj\_02b\_2311},
  year         = {2023},
  month        = nov,
  url          = {https://www.ieee802.org/3/dj/public/23_11/welch_3dj_02b_2311.pdf},
  note         = {Read in full 2026-10-18 (PDF, 27 slides). Class: proposed standard (task-force baseline, later revised). 200GBASE-DR1-FECo: 106.25 GBd PAM4; lane wavelengths 1304.5 to 1317.5 nm; TDECQ max 3.4 dB; ER min 3.5 dB; RX sensitivity (OMAouter) -4.3 + TECQ for 0.9 dB <= TECQ <= SECQ (-3.4 dBm below 0.9 dB); channel insertion loss 3 dB; 500 m; ORL tolerance 21.4 dB (15.5 for DR1); TX and RX reflectance -26 dB; FECo = RS(544,514). This 2023 version still has OMAouter min -1.2 + MAX(TECQ,TDECQ), power budget 6.5 dB and penalties 3.5 dB, superseded by johnson2025_3dj_mpidgd.}
}

